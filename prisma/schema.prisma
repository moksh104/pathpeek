// PathPeek — Smart Tourism & Travel Booking Portal
// Prisma schema for DEVSTORM-2026 hackathon
// Database: SQLite (no enums — use String for role/status)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String // Must store bcrypt-hashed password, never plaintext
  role      String    @default("user") // "user" | "admin"
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── Destination ─────────────────────────────────────────
// Seeded from src/data/places.ts (43 curated Indian destinations)
model Destination {
  id                  String     @id @default(cuid())
  name                String
  mood                String // Peaceful | Adventure | Romantic | Scenic Nature | Party
  state               String
  city                String
  budget              Int // Base price in INR
  rating              Float
  description         String
  image               String // Path relative to /public or URL
  latitude            Float
  longitude           Float
  recommendationScore Int        @default(0)
  hotels              Hotel[]
  activities          Activity[]
  bookings            Booking[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

// ─── Hotel ───────────────────────────────────────────────
model Hotel {
  id            String      @id @default(cuid())
  name          String
  pricePerNight Int // INR
  rating        Float
  amenities     String // Comma-separated, e.g. "WiFi, Pool, Spa"
  image         String?
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  bookings      Booking[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ─── Activity ────────────────────────────────────────────
model Activity {
  id            String      @id @default(cuid())
  name          String
  price         Int // INR
  duration      String // e.g. "2 hours", "Half day", "Full day"
  description   String?
  image         String?
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  bookings      Booking[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ─── Booking ─────────────────────────────────────────────
model Booking {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  hotelId       String?
  hotel         Hotel?      @relation(fields: [hotelId], references: [id])
  checkIn       DateTime
  checkOut      DateTime
  guests        Int         @default(1)
  totalPrice    Int // INR
  status        String      @default("confirmed") // confirmed | cancelled | completed
  activities    Activity[] // Implicit many-to-many (_ActivityToBooking)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
